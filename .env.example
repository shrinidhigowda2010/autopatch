# Copy to .env and fill in. Never commit the real file.

# Google Gemini. Leave blank to run in demo/offline mode
# (static analysis + cached explanations for the bundled samples).
GEMINI_API_KEY=

# Primary model, then the fallback used after retries time out.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_S=25

# SQLite by default. On Render, point this at Postgres:
# postgresql://user:pass@host:5432/autopatch
DATABASE_URL=

# Upload cap in megabytes. Zip bombs are also capped while extracting.
MAX_UPLOAD_MB=8

# JWT signing secret for login tokens (access token lasts 24h).
# Generate a long random string for production.
JWT_SECRET=dev-only-change-me-autopatch-jwt-secret
